# ==============================================================================
# Codex Meat Proxy — Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust as needed for your local workstation:
#   cp .env.example .env
# ==============================================================================

# Custom Codex Skills Directory (default: ~/.codex/skills)
# CODEX_SKILLS_DIR="$HOME/.codex/skills"

# ------------------------------------------------------------------------------
# Tooling & Fallbacks
# ------------------------------------------------------------------------------
# Optional Windows PowerShell wrapper for Git HTTPS authentication fallback
# WINDOWS_GIT_GH_WRAPPER="C:\tools\git-gh.ps1"

# ------------------------------------------------------------------------------
# Analytics & Observability (Used by posthog-analytics)
# ------------------------------------------------------------------------------
# POSTHOG_API_KEY="phx_..."
# POSTHOG_HOST="https://us.i.posthog.com"

# ------------------------------------------------------------------------------
# App Subscriptions & In-App Purchases (Used by revenuecat-operations)
# ------------------------------------------------------------------------------
# REVENUECAT_API_KEY="appl_..."

# ------------------------------------------------------------------------------
# App Store Connect Operations (Used by app-store-connect-operations)
# ------------------------------------------------------------------------------
# APP_STORE_CONNECT_API_KEY_ID="..."
# APP_STORE_CONNECT_ISSUER_ID="..."
# APP_STORE_CONNECT_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_....p8"

# ------------------------------------------------------------------------------
# Graphify Knowledge Graph (Used by graphify)
# ------------------------------------------------------------------------------
# GRAPHIFY_NEO4J_URL="bolt://localhost:7687"
# GRAPHIFY_NEO4J_USER="neo4j"
# GRAPHIFY_NEO4J_PASSWORD=""
